# This script is only meant to be ran on the actual RPi4 device.
post_install() {
    systemctl enable systemd-timesyncd 
    systemctl enable pulseaudio.service
    # NOTE: upstream OVOS disabled getty@tty1 here. We keep the HASS kiosk on
    # tty1 (autologin as `hass` -> startx -> chromium --kiosk), so leave the
    # getty enabled rather than disabling it.
}

post_upgrade() {
    post_install
}