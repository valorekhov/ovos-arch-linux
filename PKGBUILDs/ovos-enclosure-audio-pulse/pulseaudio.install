post_install() {
    # Remove any previously appended OVOS block so upgrades pick up new settings
    # (the block is always written last, so this is marker..EOF).
    if grep -q "# Installed by Package 'ovos-enclosure-audio-pulse'" /etc/pulse/daemon.conf; then
        sed -i "/# Installed by Package 'ovos-enclosure-audio-pulse'/,\$d" /etc/pulse/daemon.conf
        # drop trailing blank lines left behind by the removed block
        sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' /etc/pulse/daemon.conf
    fi

    echo "" >> /etc/pulse/daemon.conf
    echo "# Installed by Package 'ovos-enclosure-audio-pulse'" >> /etc/pulse/daemon.conf
    cat /etc/pulse/daemon.ovos.conf >> /etc/pulse/daemon.conf

    echo "Updated /etc/pulse/daemon.conf"

    # Disable global spawning for users per https://www.freedesktop.org/wiki/Software/PulseAudio/Documentation/User/SystemWide/
    systemctl --global disable pulseaudio.service pulseaudio.socket
}

post_upgrade() {
    post_install
}