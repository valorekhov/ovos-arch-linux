### SJ201 / Mark II audio settings
# The mainline simple-audio-card exposes playback as hw:CARD=sj201,DEV=0 at a
# fixed S16_LE / 2ch / 16000 Hz, and capture as DEV=1, which the nabu-satellite
# arecord process owns. Pulse must therefore open only the playback side and run
# the sink at the card's native rate.
.nofail

# Auto-detection (module-udev-detect) would create a full alsa-card for the sj201
# -- including its capture source, which the satellite already holds -- and would
# also expose the HDMI card. Load the playback sink explicitly instead.
unload-module module-udev-detect

load-module module-alsa-sink device=hw:CARD=sj201,DEV=0 rate=16000 channels=2 format=s16le sink_name=sj201
set-default-sink sj201

# Duck music when an announcement plays (role=notification/phone).
load-module module-role-ducking