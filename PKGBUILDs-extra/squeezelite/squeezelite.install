post_install() {
    echo ":: squeezelite installed. Server and output are configured in"
    echo "::   /etc/conf.d/squeezelite (SQUEEZELITE_ARGS)."
    echo ":: Enable the client with: systemctl enable --now squeezelite.service"
    systemctl enable squeezelite.service
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl disable squeezelite.service
}