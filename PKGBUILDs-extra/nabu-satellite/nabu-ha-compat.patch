+    /// The end-of-speech detector's contract: nothing until speech is heard, then a run of
+    /// sub-threshold chunks, then a stop. Silence with no speech before it must NOT end the turn.
+    #[test]
+    fn end_of_speech_requires_speech_then_silence() {
+        // 80 ms chunk (5 frames) at the tone the earshot sanity test scored >0.5, after warm-up.
+        let speech: Vec<i16> =
+            (0..1280).map(|i| ((i as f32 * 0.08).sin() * 5000.0) as i16).collect();
+        let silence = vec![0i16; 1280];
+
+        // Threshold 0.4 (not the 0.5 default): the synthetic tone earshot scores as voice sits
+        // near 0.5, so this proves the mechanism, not the model's accuracy on a pure tone.
+        // Silence alone never arms the detector (the backstop test covers the far edge).
+        let mut quiet_only = EndOfSpeech::new(240);
+        for _ in 0..20 {
+            assert!(!quiet_only.observe(&silence, 0.4), "silence alone must not end the turn");
+        }
+
+        // Speech arms it; none of the spoken chunks ends the turn on its own.
+        let mut eos = EndOfSpeech::new(240);
+        for _ in 0..5 {
+            assert!(!eos.observe(&speech, 0.4), "speech must not end the turn");
+        }
+        // A run of silence then closes it (the exact chunk depends on earshot's frame context,
+        // so only the fact that it ends — within a sane bound — is asserted).
+        let mut ended = false;
+        for _ in 0..20 {
+            if eos.observe(&silence, 0.4) { ended = true; break; }
+        }
+        assert!(ended, "speech followed by sustained silence must end the turn");
+    }
