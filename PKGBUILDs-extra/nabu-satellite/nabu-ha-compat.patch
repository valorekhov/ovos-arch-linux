+/// 16 ms at 16 kHz — earshot's one frame size.
+const VAD_FRAME_SAMPLES: usize = 256;
+/// The mic chunk cadence (see Config::preroll_chunks).
+const CHUNK_MS: u32 = 80;
+/// Safety net: close the turn after this much streamed audio even if no speech was ever seen, so a
+/// wake that opens the mic onto silence can never wedge the socket the way the pre-VAD binary did.
+/// Well above any spoken command.
+const MAX_UTTERANCE_MS: u32 = 20_000;
+
+/// Local end-of-speech detection over the live command audio. The streaming path already forwards
+/// each 80 ms mic chunk to the hub; the same audio is scored here so the turn can close on its own.
+/// Home Assistant's assist socket only ends an utterance when it receives `audio-stop` (or its own
+/// server-side VAD fires), and this binary previously sent neither — the Ziggurat hub endpointed
+/// server-side, so nothing local was ever needed. earshot is a pure-Rust VAD (16 kHz, exactly
+/// 256-sample / 16 ms frames), so one 80 ms chunk is exactly 5 frames.
+struct EndOfSpeech {
+    detector: earshot::Detector,
+    /// Sub-threshold chunks required after speech before the turn ends.
+    silence_chunks: u32,
+    speech_seen: bool,
+    quiet_chunks: u32,
+    /// Chunks observed since the turn began, for the max-utterance safety net.
+    total_chunks: u32,
+}
+
+impl EndOfSpeech {
+    fn new(silence_ms: u32) -> Self {
+        Self {
+            detector: earshot::Detector::default(),
+            silence_chunks: silence_ms.div_ceil(CHUNK_MS).max(1),
+            speech_seen: false,
+            quiet_chunks: 0,
+            total_chunks: 0,
+        }
+    }
+
+    /// Begin a new turn. The detector carries context between frames, so it must never see the
+    /// previous turn's audio.
+    fn reset(&mut self) {
+        self.detector.reset();
+        self.speech_seen = false;
+        self.quiet_chunks = 0;
+        self.total_chunks = 0;
+    }
+
+    /// Score one forwarded 80 ms chunk. Returns true once the turn's speech has ended: either
+    /// `silence_ms` of sub-threshold audio after speech, or the max-utterance safety net.
+    fn observe(&mut self, samples: &[i16], threshold: f32) -> bool {
+        self.total_chunks += 1;
+        let mut spoke = false;
+        for frame in samples.chunks_exact(VAD_FRAME_SAMPLES) {
+            if self.detector.predict_i16(frame) >= threshold {
+                spoke = true;
+            }
+        }
+        if spoke {
+            self.speech_seen = true;
+            self.quiet_chunks = 0;
+        } else if self.speech_seen {
+            self.quiet_chunks += 1;
+        }
+        (self.speech_seen && self.quiet_chunks >= self.silence_chunks)
+            || self.total_chunks.saturating_mul(CHUNK_MS) >= MAX_UTTERANCE_MS
+    }
+}
