+/// The reply to a Wyoming `describe`: Home Assistant's client uses it to register the satellite.
+/// Only the `satellite` block is populated — this binary is a satellite, not a standalone
+/// ASR/TTS/wake service — but the empty service lists are required keys in the wyoming `Info`
+/// dataclass, and `Artifact`'s name/attribution/installed/description/version are all required.
+fn info_event(cfg: &Config) -> WyomingEvent {
+    WyomingEvent::with_data("info", json!({
+        "asr": [], "tts": [], "handle": [], "intent": [], "wake": [], "mic": [], "snd": [],
+        "satellite": {
+            "name": cfg.name,
+            "attribution": {
+                "name": "Ziggurat",
+                "url": "https://github.com/Dethon/Ziggurat",
+            },
+            "installed": true,
+            "description": "Nabu Rust Wyoming satellite",
+            "version": env!("CARGO_PKG_VERSION"),
+            "area": null,
+            "has_vad": cfg.vad,
+            "active_wake_words": null,
+            "max_active_wake_words": null,
+            "supports_trigger": false,
+        },
+    }))
+}
+
+/// The reply to a `describe` or `ping`, or `None` if `e` is neither. Shared by the pre-arm control
+/// loop and the armed event handler so liveness is answered identically on both sides of arming.
+fn control_reply(e: &WyomingEvent, cfg: &Config) -> Option<WyomingEvent> {
+    match e.event_type.as_str() {
+        "describe" => Some(info_event(cfg)),
+        // Copy the request's opaque text through, as the protocol requires (`Pong.text`).
+        "ping" => {
+            let text = e.data_obj().get("text").cloned();
+            Some(WyomingEvent::with_data("pong", json!({ "text": text })))
+        }
+        _ => None,
+    }
+}
+
+/// Claim the single audio session: supersede any previous armed connection, then record ours so a
+/// later session can supersede us. Awaiting the previous task's teardown is what leaves the
+/// exclusive ALSA devices free (its `AbortOnDrop` pumps kill arecord) before we open them.
+async fn arm_session(session: &SessionSlot, my_handle: JoinHandle<()>) {
+    let mut slot = session.lock().await;
+    if let Some(prev) = slot.take() {
+        // A re-arm on the same connection (`run-satellite` sent twice) must not abort ourselves.
+        if prev.id() != my_handle.id() {
+            info!("superseding previous session");
+            prev.abort();
+            let _ = prev.await;
+        }
+    }
+    *slot = Some(my_handle);
+}
